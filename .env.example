# Copiar como .env y completar
PORT=3000
NODE_ENV=development

# PostgreSQL (Render u otro proveedor)
DATABASE_URL=postgresql://usuario:password@host:5432/gliz_star
PGSSL=true

# Autenticación
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=30d

# Almacenamiento de imágenes (fotos de cortes y QR de pagos)
# Opción simple local para desarrollo; en producción usar S3/Cloudinary/Supabase Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/uploads

# Si se usa un proveedor externo (ejemplo Cloudinary)
# CLOUDINARY_URL=cloudinary://key:secret@cloud_name
